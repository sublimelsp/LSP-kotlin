{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>sublimelsp/renovate-preset",
    "github>sublimelsp/renovate-preset:automerge-server"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/plugin.py$/"
      ],
      "matchStrings": [
        "VERSION = '(?<currentValue>[^']+)'"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "Kotlin/kotlin-lsp",
      "extractVersionTemplate": "^kotlin-lsp/v(?<version>.+)$",
      "versioningTemplate": "loose"
    }
  ]
}
